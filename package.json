{
  "name": "@cubig/design-system",
  "version": "0.21.33",
  "description": "A comprehensive design system built with React, TypeScript, and styled-components. Includes Label, Description, Input, TextField, Checkbox components with dynamic trailing icons and responsive design tokens.",
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "ui-components",
    "styled-components",
    "input",
    "textfield",
    "label",
    "description",
    "checkbox"
  ],
  "private": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "src/assets",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles/*": "./src/styles/*",
    "./assets/*": "./src/assets/*"
  },
  "homepage": "https://cubigcorp.github.io/design-system-template/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubigcorp/design-system-template.git"
  },
  "bugs": {
    "url": "https://github.com/cubigcorp/design-system-template/issues"
  },
  "author": "Cubig",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "gh-pages -d storybook-static",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "lib:build": "npm run generate:icons && vite build",
    "lib:watch": "vite build --watch",
    "lib:clean": "rm -rf dist",
    "lib:prepare": "npm run lib:clean && npm run lib:build",
    "prepublishOnly": "npm run lib:prepare",
    "release": "npm run lib:prepare && npm version patch && git push && git push --tags && echo '\\n이제 npm publish 실행하세요'",
    "release:minor": "npm run lib:prepare && npm version minor && git push && git push --tags && echo '\\n이제 npm publish 실행하세요'",
    "release:major": "npm run lib:prepare && npm version major && git push && git push --tags && echo '\\n이제 npm publish 실행하세요'",
    "storybook:deploy": "npm run build-storybook && npm run deploy-storybook"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "styled-components": ">=6.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.0",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^9.0.8",
    "@storybook/addon-docs": "^9.0.8",
    "@storybook/addon-onboarding": "^9.0.8",
    "@storybook/addon-vitest": "^9.0.8",
    "@storybook/react-vite": "^9.0.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^5.0.4",
    "styled-components": "^6.1.19",
    "@vitest/browser": "^3.2.3",
    "@vitest/coverage-v8": "^3.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-plugin-storybook": "^9.0.8",
    "gh-pages": "^6.3.0",
    "playwright": "^1.53.0",
    "postcss": "^8.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^9.0.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.3"
  }
}
